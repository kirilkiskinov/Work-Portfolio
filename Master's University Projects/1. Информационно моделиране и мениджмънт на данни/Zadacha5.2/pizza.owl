    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Meet_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Meet_topping">
