    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Seafood_pizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Seafood_pizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
