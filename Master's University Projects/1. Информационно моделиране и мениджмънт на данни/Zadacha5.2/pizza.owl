                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mild_value"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Gorganzolla_topping_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Gorganzolla_topping_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Cheese_topping"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mozzarella_topping_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Ham_topping_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Ham_topping_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Meet_topping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
