<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15/"
     xml:base="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_base -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_base">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#relational_property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza_base"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_spiciness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_spiciness">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#modifier_property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza_topping"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Spiciness_value"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#relational_property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza_topping"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#modifier_property -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#modifier_property">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#relational_property -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#relational_property">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Anchovy_topping_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Anchovy_topping_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Seafood_topping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_spiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mild_value"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Tuna_topping_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Cheese_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Cheese_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza_topping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_spiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mild_value"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Cheesy_pizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Cheesy_pizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Gorganzolla_topping_topping"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mozzarella_topping_topping"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Tomato_topping_topping"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Gorganzolla_topping_topping"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mozzarella_topping_topping"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Tomato_topping_topping"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Domain_entity -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Domain_entity"/>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Fruit_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Fruit_topping">
