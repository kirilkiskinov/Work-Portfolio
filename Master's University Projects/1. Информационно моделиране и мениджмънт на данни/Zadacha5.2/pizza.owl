                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Medium_value"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Hot_and_spicy_pizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Hot_and_spicy_pizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_spiciness"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Hot_value"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mozzarella_topping_topping"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Spicy_beef_topping"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Tomato_topping_topping"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#has_topping"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Mozzarella_topping_topping"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Spicy_beef_topping"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Tomato_topping_topping"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Hot_value -->

    <owl:Class rdf:about="http://www.semanticweb.org/kiril/ontologies/2024/10/untitled-ontology-15#Hot_value">
